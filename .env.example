# --- Database ----------------------------------------------------------------
# PostgreSQL connection string used by Drizzle ORM and the API routes.
DATABASE_URL="postgresql://postgres:password@localhost:5432/cloudnode"

# --- Authentication ----------------------------------------------------------
# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Public app URL (optional) -----------------------------------------------
# Used to build absolute share-link URLs in API responses.
# If unset, the request origin is used where possible.
# NEXT_PUBLIC_APP_URL="https://files.example.com"

# --- Collaboration server (optional) ------------------------------------------
# WebSocket endpoint for the collaborative editor, if not running on the same
# host's port 1234 as default.
# NEXT_PUBLIC_WS_URL="ws://localhost:1234"
# WS_PORT=1234